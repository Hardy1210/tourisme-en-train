# Variables de production, SANS aucun secret : les vraies valeurs vont dans Coolify, jamais dans Git.
# Mots de passe : lettres, chiffres et . _ ~ - uniquement (ils sont insérés tels quels dans les adresses postgres://).
# Référence : docs/07-contrat-infra.md § 3.
POSTGRES_DB=tourisme
POSTGRES_USER=proprietaire
POSTGRES_PASSWORD=a-remplir
MDP_APP_LECTURE=a-remplir
MDP_ETL_ECRITURE=a-remplir
# L'adresse publique : changer de domaine = cette variable + le réglage Coolify.
URL_APP=https://wagoo.hardylino.com
# Facultative (temps réel, P1).
SNCF_CLE_API=
