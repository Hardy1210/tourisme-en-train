# Secrets — jamais dans le dépôt
.env
.env.*
# Fichiers d'exemple versionnés (ex. .env.example, infra/.env.prod.example)
!*.example

# Exports de la base (infra/README.md)
*.dump

# Données téléchargées et produites par le traitement (seuls les dossiers sont versionnés)
data/*
!data/brut/
data/brut/*
!data/brut/.gitkeep
!data/traite/
data/traite/*
!data/traite/.gitkeep

# Dépendances et constructions
node_modules/
.next/
out/
dist/
*.tsbuildinfo
next-env.d.ts

# Sorties de tests
coverage/
test-results/
playwright-report/

# Éditeurs et système
.DS_Store
*.log

# Maquettes HTML complètes (2,5 Mo chacune) : gardées en local, D067
design/maquettes/*.html
