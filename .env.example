# Variables d'environnement — exemple versionné, SANS aucun secret.
# Copier en .env (ignoré par Git) puis remplir les mots de passe : cp .env.example .env
# Référence : docs/07-contrat-infra.md § 3.

# --- Base de données (image db) ---
POSTGRES_DB=tourisme
POSTGRES_USER=proprietaire
POSTGRES_PASSWORD=a-remplir

# Mots de passe des rôles, créés par le script lancé par `pnpm db:migrer` (D031)
MDP_APP_LECTURE=a-remplir
MDP_ETL_ECRITURE=a-remplir

# Port de la base côté poste (local uniquement, D030). 5432 par défaut ; 5433 si un autre projet occupe 5432.
BDD_PORT_HOTE=5432

# Adresses vues depuis le POSTE (pnpm dev, pnpm etl, pnpm db:migrer).
# Le port doit être celui de BDD_PORT_HOTE ; les conteneurs reçoivent leurs propres adresses (db:5432) du compose.
BDD_URL_MIGRATIONS=postgres://proprietaire:a-remplir@localhost:5432/tourisme
BDD_URL_APP=postgres://app_lecture:a-remplir@localhost:5432/tourisme
BDD_URL_ETL=postgres://etl_ecriture:a-remplir@localhost:5432/tourisme

# --- Application web ---
URL_APP=http://localhost:3000
NODE_ENV=development
# Clé de l'API SNCF (temps réel, P1) — facultative
SNCF_CLE_API=

# --- Traitement des données ---
DOSSIER_DONNEES=./data
